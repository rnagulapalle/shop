DATABASE_URL=sqlite:///./shop.db
# Real Stripe: https://api.stripe.com, or a FetchSandbox twin base URL for testing.
STRIPE_API_BASE=https://api.stripe.com
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_BASE=https://api.resend.com
RESEND_API_KEY=re_...
EMAIL_FROM=Shop <orders@yourdomain.com>
FRONTEND_ORIGIN=http://localhost:3000
# Staff-only mutations (fulfillOrder, refundOrder) require this in x-admin-token.
ADMIN_TOKEN=change-me
# Optional JSON object of headers added to every provider call (e.g. FetchSandbox X-Flow-Run-Id).
PROVIDER_EXTRA_HEADERS=
